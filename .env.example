# PostgreSQL-Verbindung (auf Railway: ${{Postgres.DATABASE_URL}})
DATABASE_URL=postgres://fl:fl@localhost:5432/football_legacy
# Nur nötig, wenn die Datenbank SSL erzwingt und kein internes Netzwerk genutzt wird
DATABASE_SSL=false
# Migrationen beim Start überspringen (Standard: ausführen)
SKIP_MIGRATIONS=false

{
  "name": "football-legacy",
  "private": true,
  "version": "0.1.0",
  "description": "Football Legacy – Schreibe Fussball Geschichte. Fussball-Manager im Browser.",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "check:lines": "node scripts/check-lines.mjs",
    "test": "pnpm -r test",
    "dev": "pnpm --filter @fl/web dev",
    "start": "pnpm --filter @fl/web start",
    "migrate": "pnpm --filter @fl/game migrate",
    "sim:season": "pnpm --filter @fl/sim season",
    "sim:calibrate": "pnpm --filter @fl/sim calibrate"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}

{
  "name": "football-legacy",
  "private": true,
  "version": "0.1.0",
  "description": "Football Legacy – Schreibe Fussball Geschichte. Fussball-Manager im Browser.",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "check:lines": "node scripts/check-lines.mjs",
    "test": "pnpm -r test",
    "dev": "pnpm --filter @fl/web dev",
    "start": "pnpm --filter @fl/web start",
    "migrate": "pnpm --filter @fl/game migrate",
    "sim:season": "pnpm --filter @fl/sim season",
    "sim:calibrate": "pnpm --filter @fl/sim calibrate",
    "e2e": "node apps/web/e2e/smoke.mjs",
    "e2e:flows": "node apps/web/e2e/flows.mjs",
    "e2e:a11y": "node apps/web/e2e/a11y.mjs",
    "e2e:i18n": "node apps/web/e2e/i18n.mjs",
    "i18n:extract": "pnpm --filter @fl/i18n extract",
    "loadtest": "node scripts/loadtest.mjs"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "devDependencies": {
    "axe-core": "^4.14.0",
    "playwright": "1.63.0"
  }
}
